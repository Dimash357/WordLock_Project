    "Все слова снова станут новыми. Отменить это нельзя.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All words will become new again. This cannot be undone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі слова знову стануть новими. Скасувати це неможливо."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все слова снова станут новыми. Отменить это нельзя."
          }
        }
      }
    },
    "Встроенные слова можно вернуть в настройках.": {
